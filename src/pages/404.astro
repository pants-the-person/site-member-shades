---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { withBase } from '../lib/site';
---

<Base title={`404 — ${site.displayName}`} description="This page could not be found.">
  <h1>404 &mdash; File Not Found</h1>
  <p class="center" style="font-family:'Courier New',monospace">
    The page you requested has been moved, deleted, or never existed at all.
  </p>

  <pre class="ascii" aria-hidden="true">{`  +----------------------------------+
  |  ERROR 404: PAGE NOT FOUND       |
  |                                  |
  |   ___    ___    ___    ___       |
  |  | 4 |  | 0 |  | 4 |  | ! |      |
  |  |___|  |___|  |___|  |___|      |
  |                                  |
  |  Check the URL and try again.    |
  +----------------------------------+`}</pre>

  <p class="center">
    <a class="big-link" href={withBase('/')}>Take me home &raquo;</a>
  </p>

  <p class="center tiny">
    Or e-mail the webmaster at <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</Base>
